# M8 Minima kernel config fragment, merged over arch/arm64/configs/imx_v8_defconfig
# by scripts/build-kernel-m8-minima.sh.

# PMIC (ROHM BD71847)
CONFIG_MFD_ROHM_BD718XX=y
CONFIG_REGULATOR_BD718XX=y

# PCIe host (M.2 Key-E), SoC-generated refclk
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEASPM=y
CONFIG_PCI_IMX6_HOST=y
CONFIG_PHY_FSL_IMX8M_PCIE=y

# Intel AX210 WiFi (PCIe)
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m

# Intel AX210 Bluetooth (USB, behind the USB2514B hub)
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_INTEL=m

# USB host path: usbotg2 -> USB2514B hub -> M.2 USB
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_EHCI_HCD=y

# Firmware (iwlwifi-ty-a0-gf-a0-*.ucode/.pnvm, intel/ibt-0041-0041.*),
# accept xz/zstd-compressed blobs as shipped by some distros
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
