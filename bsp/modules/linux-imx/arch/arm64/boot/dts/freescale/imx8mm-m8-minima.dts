/dts-v1/;

#include "imx8mm-m8-minima-evk-base.dtsi"


/ {
	model = "CRLS M8 Minima";
	compatible = "crls,m8-minima", "fsl,imx8mm";

	/* EVK peripherals that are not on this board (see MIMX8MM6xxxLZ.mex) */
	/delete-node/ hdmi-connector;
	/delete-node/ leds;
	/delete-node/ backlight;
	/delete-node/ ir-receiver;
	/delete-node/ sound-bt-sco;
	/delete-node/ sound-wm8524;
	/delete-node/ sound-micfil;
	/delete-node/ sound-spdif;
	/delete-node/ audio-codec-bt-sco;
	/delete-node/ audio-codec;
	/delete-node/ spdif-out;
	/delete-node/ spdif-in;
	/delete-node/ regulator-usdhc2;
};

/* Only I2C1 (PMIC) is routed; I2C2/I2C3 carry EVK-only devices */
&i2c2 {
	status = "disabled";
	/delete-node/ hdmi@3d;
	/delete-node/ tcpc@50;
};

&i2c3 {
	status = "disabled";
};

&csi {
	status = "disabled";
};

&mipi_csi {
	status = "disabled";
};

&lcdif {
	status = "disabled";
};

&mipi_dsi {
	status = "disabled";

	ports {
		/delete-node/ port@1;
	};
};

&micfil {
	status = "disabled";
};

/* SAI2_TXC is reused for ENET_INT_B */
&sai2 {
	status = "disabled";
};

&sai3 {
	status = "disabled";
};

&pwm1 {
	status = "disabled";
};

&fec1 {
	pinctrl-0 = <&pinctrl_fec1>, <&pinctrl_enet_ctrl>;
	phy-mode = "rgmii-id";
};

&ethphy0 {
	reg = <1>;
	/delete-property/ qca,disable-smarteee;
	/*
	 * Rev 2: PHYRSTB is a 3.3 V input on the RTL8211F, so ENET_RST_B moved
	 * from SAI2_TXFS (1.8 V NVCC_SAI2) to I2C4_SDA (3.3 V NVCC_I2C).
	 */
	reset-gpios = <&gpio5 21 GPIO_ACTIVE_LOW>;	/* ENET_RST_B, I2C4_SDA */
	interrupt-parent = <&gpio4>;
	interrupts = <25 IRQ_TYPE_LEVEL_LOW>;		/* ENET_INT_B, SAI2_TXC */
	vddio-supply = <&reg_rgmii_vddio>;
};

&i2c1 {
	clock-frequency = <384000>;
};

/*
 * M.2 Key-E (J1101), populated with an Intel AX210: PCIe x1 for WiFi,
 * USB2 (via USB2514B DN4) for Bluetooth. There is no external clock
 * generator; the SoC drives the 100 MHz refclk out of PCIE_REF_PAD_CLK.
 * CLKREQ# is routed, but the refclk is kept free-running for bring-up.
 */
&pcie_phy {
	clocks = <&clk IMX8MM_CLK_PCIE1_PHY>;
	clock-names = "ref";
	fsl,refclk-pad-mode = <IMX8_PCIE_REFCLK_PAD_OUTPUT>;
	fsl,clkreq-unsupported;
};

&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pcie0>;
	reset-gpio = <&gpio5 13 GPIO_ACTIVE_LOW>;	/* PCI_RST_B, ECSPI2_SS0 */
	clocks = <&clk IMX8MM_CLK_PCIE1_ROOT>, <&clk IMX8MM_CLK_PCIE1_PHY>,
		 <&clk IMX8MM_CLK_PCIE1_AUX>;
	vpcie-supply = <&reg_pcie0>;
	status = "okay";
};

/* M.2 3.3 V comes straight from BUCK6, no load switch */
&reg_pcie0 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	/delete-property/ gpio;
	/delete-property/ enable-active-high;
	regulator-name = "M2_3V3";
	regulator-always-on;
};

/*
 * UART2/UART4 are 115200 login consoles (CH342K). SDMA needs NXP's
 * sdma-imx7d.bin (not shipped), and without it UART4 floods the log with
 * "cannot prepare for the TX slave dma", so run both in PIO mode.
 */
&uart2 {
	/delete-property/ dmas;
	/delete-property/ dma-names;
};

&uart4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart4>;
	/delete-property/ dmas;
	/delete-property/ dma-names;
	status = "okay";
};

&usbotg1 {
	dr_mode = "peripheral";
	/delete-property/ hnp-disable;
	/delete-property/ srp-disable;
	/delete-property/ adp-disable;
	/delete-property/ usb-role-switch;
	/delete-property/ disable-over-current;
	/delete-node/ port;
};

&usbotg2 {
	dr_mode = "host";
	status = "okay";
};

&usdhc1 {
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc1>;
	pinctrl-1 = <&pinctrl_usdhc1_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc1_200mhz>;
	bus-width = <8>;
	vmmc-supply = <&reg_emmc_vmmc>;
	vqmmc-supply = <&reg_emmc_vqmmc>;
	non-removable;
	status = "okay";
};

/* microSD: no card-detect line on this board */
&usdhc2 {
	/delete-property/ cd-gpios;
	/delete-property/ vmmc-supply;
	pinctrl-0 = <&pinctrl_usdhc2>;
	pinctrl-1 = <&pinctrl_usdhc2_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc2_200mhz>;
	broken-cd;
	bus-width = <4>;
	status = "okay";
};

&wdog1 {
	pinctrl-0 = <&pinctrl_wdog>;
};

&iomuxc {
	/* EVK group minus SAI2_RXC (EVK PHY reset, unused here) */
	pinctrl_fec1: fec1grp {
		fsl,pins = <
			MX8MM_IOMUXC_ENET_MDC_ENET1_MDC			0x3
			MX8MM_IOMUXC_ENET_MDIO_ENET1_MDIO		0x3
			MX8MM_IOMUXC_ENET_TD3_ENET1_RGMII_TD3		0x1f
			MX8MM_IOMUXC_ENET_TD2_ENET1_RGMII_TD2		0x1f
			MX8MM_IOMUXC_ENET_TD1_ENET1_RGMII_TD1		0x1f
			MX8MM_IOMUXC_ENET_TD0_ENET1_RGMII_TD0		0x1f
			MX8MM_IOMUXC_ENET_RD3_ENET1_RGMII_RD3		0x91
			MX8MM_IOMUXC_ENET_RD2_ENET1_RGMII_RD2		0x91
			MX8MM_IOMUXC_ENET_RD1_ENET1_RGMII_RD1		0x91
			MX8MM_IOMUXC_ENET_RD0_ENET1_RGMII_RD0		0x91
			MX8MM_IOMUXC_ENET_TXC_ENET1_RGMII_TXC		0x1f
			MX8MM_IOMUXC_ENET_RXC_ENET1_RGMII_RXC		0x91
			MX8MM_IOMUXC_ENET_RX_CTL_ENET1_RGMII_RX_CTL	0x91
			MX8MM_IOMUXC_ENET_TX_CTL_ENET1_RGMII_TX_CTL	0x1f
		>;
	};

	pinctrl_enet_ctrl: enetctrlgrp {
		fsl,pins = <
			MX8MM_IOMUXC_I2C4_SDA_GPIO5_IO21	0x19	/* ENET_RST_B */
			MX8MM_IOMUXC_SAI2_TXC_GPIO4_IO25	0x141	/* ENET_INT_B */
		>;
	};

	pinctrl_pcie0: pcie0grp {
		fsl,pins = <
			MX8MM_IOMUXC_I2C4_SCL_PCIE1_CLKREQ_B	0x61	/* CLKREQ_B */
			MX8MM_IOMUXC_ECSPI2_SS0_GPIO5_IO13	0x19	/* PCI_RST_B */
		>;
	};

	/* 3.3 V (NVCC_ECSPI) sidebands, all with 10k pull-ups to 3.3 V */
	pinctrl_gpio5: gpio5grp {
		fsl,pins = <
			MX8MM_IOMUXC_ECSPI2_MOSI_GPIO5_IO11	0x19	/* HUB_RST_B */
			MX8MM_IOMUXC_ECSPI1_MISO_GPIO5_IO8	0x19	/* W_DIS1_B (WiFi) */
			MX8MM_IOMUXC_ECSPI1_SS0_GPIO5_IO9	0x19	/* W_DIS2_B (BT) */
			MX8MM_IOMUXC_ECSPI2_MISO_GPIO5_IO12	0x140	/* PCI_WAKE_B */
		>;
	};

	pinctrl_uart4: uart4grp {
		fsl,pins = <
			MX8MM_IOMUXC_UART4_RXD_UART4_DCE_RX	0x140
			MX8MM_IOMUXC_UART4_TXD_UART4_DCE_TX	0x140
		>;
	};

	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			MX8MM_IOMUXC_SD1_CLK_USDHC1_CLK		0x190
			MX8MM_IOMUXC_SD1_CMD_USDHC1_CMD		0x1d0
			MX8MM_IOMUXC_SD1_DATA0_USDHC1_DATA0	0x1d0
			MX8MM_IOMUXC_SD1_DATA1_USDHC1_DATA1	0x1d0
			MX8MM_IOMUXC_SD1_DATA2_USDHC1_DATA2	0x1d0
			MX8MM_IOMUXC_SD1_DATA3_USDHC1_DATA3	0x1d0
			MX8MM_IOMUXC_SD1_DATA4_USDHC1_DATA4	0x1d0
			MX8MM_IOMUXC_SD1_DATA5_USDHC1_DATA5	0x1d0
			MX8MM_IOMUXC_SD1_DATA6_USDHC1_DATA6	0x1d0
			MX8MM_IOMUXC_SD1_DATA7_USDHC1_DATA7	0x1d0
			MX8MM_IOMUXC_SD1_STROBE_USDHC1_STROBE	0x190
		>;
	};

	pinctrl_usdhc1_100mhz: usdhc1-100mhzgrp {
		fsl,pins = <
			MX8MM_IOMUXC_SD1_CLK_USDHC1_CLK		0x194
			MX8MM_IOMUXC_SD1_CMD_USDHC1_CMD		0x1d4
			MX8MM_IOMUXC_SD1_DATA0_USDHC1_DATA0	0x1d4
			MX8MM_IOMUXC_SD1_DATA1_USDHC1_DATA1	0x1d4
			MX8MM_IOMUXC_SD1_DATA2_USDHC1_DATA2	0x1d4
			MX8MM_IOMUXC_SD1_DATA3_USDHC1_DATA3	0x1d4
			MX8MM_IOMUXC_SD1_DATA4_USDHC1_DATA4	0x1d4
			MX8MM_IOMUXC_SD1_DATA5_USDHC1_DATA5	0x1d4
			MX8MM_IOMUXC_SD1_DATA6_USDHC1_DATA6	0x1d4
			MX8MM_IOMUXC_SD1_DATA7_USDHC1_DATA7	0x1d4
			MX8MM_IOMUXC_SD1_STROBE_USDHC1_STROBE	0x194
		>;
	};

	pinctrl_usdhc1_200mhz: usdhc1-200mhzgrp {
		fsl,pins = <
			MX8MM_IOMUXC_SD1_CLK_USDHC1_CLK		0x196
			MX8MM_IOMUXC_SD1_CMD_USDHC1_CMD		0x1d6
			MX8MM_IOMUXC_SD1_DATA0_USDHC1_DATA0	0x1d6
			MX8MM_IOMUXC_SD1_DATA1_USDHC1_DATA1	0x1d6
			MX8MM_IOMUXC_SD1_DATA2_USDHC1_DATA2	0x1d6
			MX8MM_IOMUXC_SD1_DATA3_USDHC1_DATA3	0x1d6
			MX8MM_IOMUXC_SD1_DATA4_USDHC1_DATA4	0x1d6
			MX8MM_IOMUXC_SD1_DATA5_USDHC1_DATA5	0x1d6
			MX8MM_IOMUXC_SD1_DATA6_USDHC1_DATA6	0x1d6
			MX8MM_IOMUXC_SD1_DATA7_USDHC1_DATA7	0x1d6
			MX8MM_IOMUXC_SD1_STROBE_USDHC1_STROBE	0x196
		>;
	};
};

/*
 * Hogs use GPIO_ACTIVE_LOW + output-low, i.e. "deasserted": the pin is
 * driven high, so the hub runs and neither M.2 radio is disabled.
 */
&gpio5 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_gpio5>;

	hub-reset-hog {
		gpio-hog;
		gpios = <11 GPIO_ACTIVE_LOW>;
		output-low;
		line-name = "HUB_RST_B";
	};

	m2-wdis1-hog {
		gpio-hog;
		gpios = <8 GPIO_ACTIVE_LOW>;
		output-low;
		line-name = "W_DIS1_B";
	};

	m2-wdis2-hog {
		gpio-hog;
		gpios = <9 GPIO_ACTIVE_LOW>;
		output-low;
		line-name = "W_DIS2_B";
	};
};

/ {
	reg_emmc_vmmc: regulator-emmc-vmmc {
		compatible = "regulator-fixed";
		regulator-name = "eMMC_VCC";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_emmc_vqmmc: regulator-emmc-vqmmc {
		compatible = "regulator-fixed";
		regulator-name = "eMMC_VCCQ";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	reg_rgmii_vddio: regulator-rgmii-vddio {
		compatible = "regulator-fixed";
		regulator-name = "RGMII_VDDIO";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};
};

